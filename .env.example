HOST=localhost
PORT=8001

# --- Database ---
# Matches the credentials in docker-compose.yml.
# Run `docker compose up -d` then `yarn prisma:deploy` to apply migrations.
DATABASE_URL="postgresql://fastify:fastify@localhost:5440/fastify_dev?schema=public"


# --- Auth ---
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your-secret"
COOKIE_SECRET="your-value"
